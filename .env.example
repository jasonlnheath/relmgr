# RelMgr configuration — copy to .env and fill in. NEVER commit the real .env.
# Every value here is read by wl_env (env vars win over this file).

# Session/link signing secret (required).
WHITELIST_SECRET=change-me-to-a-long-random-string

# ------------------------------------------------------------------
# Outbound mail (mailer.py). Defaults: smtp.gmail.com:587 STARTTLS;
# port 465 switches to implicit SSL. From-address defaults to
# jasonlnheath@gmail.com (2026-09-20 ruling). Switching to a custom
# domain later = editing these lines only, zero code changes.
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jasonlnheath@gmail.com
# Gmail requires an App Password (not the account password):
# https://myaccount.google.com/apppasswords
SMTP_PASS=<APP-PASSWORD-HERE>
SMTP_FROM=jasonlnheath@gmail.com
# SMTP_REPLY_TO=jasonlnheath@gmail.com

# ------------------------------------------------------------------
# Base URL for every outbound link (reset links, decision views, QR
# codes). Default when unset: http://192.168.1.200:8099 (the LAN).
# ------------------------------------------------------------------
APP_BASE_URL=http://192.168.1.200:8099
